# Core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_ENV=development

# Database (production uses DATABASE_URL)
DATABASE_URL=postgres://reloqa:reloqa@localhost:5432/reloqa
DB_NAME=reloqa
DB_USER=reloqa
DB_PASSWORD=reloqa
DB_HOST=localhost
DB_PORT=5432

# Frontend origins for CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Cloudinary (leave blank to fall back to local media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (console backend used in dev when left blank)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=Reloqa <no-reply@reloqa.app>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL for password reset / verification links
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_ENABLED=1
